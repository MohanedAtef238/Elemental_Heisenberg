.board-shell {
    width: 100%;
    height: 100%;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(255, 171, 3);
    border-right-color: rgb(255, 171, 3);
    border-bottom-color: rgb(255, 171, 3);
    border-left-color: rgb(255, 171, 3);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-bottom-left-radius: 28px;
    background-color: rgb(41, 30, 255);
    background-image: url("project://database/Assets/UI/ooi%20heisen.png?fileID=2800000&guid=05856014e010d1f468f84571f1ed540c&type=3#ooi heisen");
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: repeat repeat;
    background-size: 128px 128px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.18);
}

.board-title {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.recipe-list {
    flex-grow: 1;
}

.recipe-row {
    margin-bottom: 6px;
    padding-top: 6px;
    padding-right: 10px;
    padding-bottom: 6px;
    padding-left: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 215, 138, 0.35);
    border-right-color: rgba(255, 215, 138, 0.35);
    border-bottom-color: rgba(255, 215, 138, 0.35);
    border-left-color: rgba(255, 215, 138, 0.35);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgba(193, 192, 192, 0.38);
}

.recipe-name {
    color: rgb(255, 183, 9);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.recipe-formula {
    color: rgb(255, 255, 255);
    font-size: 14px;
    white-space: normal;
}
